# ==============================================================================
# Listening Community – Suicide Prevention Campaign (LC-SPC)
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your environment.
# NEVER commit the actual .env file or sensitive credentials to version control.
# ==============================================================================

# Application Configuration
APP_NAME="Listening Community SPC"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_BASE_PATH=/

APP_TIMEZONE=Asia/Kolkata

# Dedicated MySQL Database Configuration
# Local development default: 127.0.0.1
# Hostinger production default: localhost
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u806388046_LC
DB_USERNAME=u806388046_LC_SPC
DB_PASSWORD=

# Session Configuration
SESSION_NAME=LCSPC_SESSION
SESSION_LIFETIME=7200

